<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.duoc.lims.limsclient.controller.ListadoMuestrasController"
      spacing="12" style="-fx-padding: 20;">

    <Label text="Listado de Muestras" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
    <Label text="Gestión y seguimiento de muestras ingresadas al laboratorio" style="-fx-text-fill: #666;" />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnNuevaMuestra" text="+ Nueva muestra" onAction="#onNuevaMuestra" />
        <Button fx:id="btnActualizar" text="Actualizar" onAction="#onActualizar" />
        <Label fx:id="lblEstado" style="-fx-text-fill: #b00;" />
    </HBox>

    <TableView fx:id="tablaMuestras" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="130" />
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120" />
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="180" />
            <TableColumn fx:id="colPrioridad" text="Prioridad" prefWidth="90" />
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="110" />
            <TableColumn fx:id="colFecha" text="Fecha ingreso" prefWidth="150" />
        </columns>
    </TableView>

</VBox>