<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.duoc.lims.limsclient.controller.ListadoMuestrasController"
      styleClass="page">

    <VBox spacing="3">
        <Label text="Listado de Muestras" styleClass="page-title"/>
        <Label text="Gestión y seguimiento de muestras ingresadas al laboratorio" styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnNuevaMuestra" text="+ Nueva muestra" styleClass="btn-primary" onAction="#onNuevaMuestra"/>
        <TextField fx:id="txtBuscar" promptText="Buscar por código, cliente o tipo..." styleClass="search-field"/>
        <Button fx:id="btnActualizar" text="Actualizar" styleClass="btn-secondary" onAction="#onActualizar"/>
        <Button text="Ver detalle" styleClass="btn-secondary" onAction="#onVerDetalle"/>
        <Label fx:id="lblEstado" styleClass="status-text"/>
    </HBox>

    <TableView fx:id="tablaMuestras" styleClass="lims-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colCodigo" text="CÓDIGO" prefWidth="130"/>
            <TableColumn fx:id="colTipo" text="TIPO" prefWidth="130"/>
            <TableColumn fx:id="colCliente" text="CLIENTE" prefWidth="200"/>
            <TableColumn fx:id="colPrioridad" text="PRIORIDAD" prefWidth="100"/>
            <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="160"/>
            <TableColumn fx:id="colFecha" text="FECHA INGRESO" prefWidth="140"/>
        </columns>
        <placeholder>
            <Label text="No hay muestras para mostrar."/>
        </placeholder>
    </TableView>

    <Label text="Doble clic en una muestra para ver su detalle" styleClass="hint"/>
</VBox>
