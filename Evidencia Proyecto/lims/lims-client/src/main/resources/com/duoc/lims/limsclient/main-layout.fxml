<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Marco principal de la app (después del login): barra lateral fija + área de contenido.
     Navigator cambia solo lo que va dentro de "contenido". -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.duoc.lims.limsclient.controller.MainLayoutController"
            styleClass="app-root">

    <left>
        <VBox styleClass="sidebar" prefWidth="210" minWidth="210">
            <Label text="LIMS · Laboratorio" styleClass="sidebar-title"/>

            <Button fx:id="btnInicio" text="Inicio" styleClass="sidebar-item"
                    maxWidth="Infinity" onAction="#onInicio"/>
            <Button fx:id="btnMuestras" text="Muestras" styleClass="sidebar-item"
                    maxWidth="Infinity" onAction="#onMuestras"/>
            <Button fx:id="btnAprobaciones" text="Aprobaciones" styleClass="sidebar-item"
                    maxWidth="Infinity" onAction="#onAprobaciones"/>
            <Button fx:id="btnInvestigadores" text="Investigadores" styleClass="sidebar-item"
                    maxWidth="Infinity" onAction="#onInvestigadores"/>
            <Button fx:id="btnSitios" text="Sitios y mapa" styleClass="sidebar-item"
                    maxWidth="Infinity" onAction="#onSitios"/>
            <Button fx:id="btnCatalogo" text="Parámetros y rangos" styleClass="sidebar-item"
                    maxWidth="Infinity" onAction="#onCatalogo"/>
            <Button fx:id="btnEquipos" text="Equipos y almacenamiento" styleClass="sidebar-item"
                    maxWidth="Infinity" onAction="#onEquipos"/>
            <Button fx:id="btnReportes" text="Reportes" styleClass="sidebar-item"
                    maxWidth="Infinity" onAction="#onReportes"/>
            <Button fx:id="btnUsuarios" text="Usuarios" styleClass="sidebar-item"
                    maxWidth="Infinity" onAction="#onUsuarios"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="sidebar-user">
                <Label fx:id="lblUsuario" styleClass="sidebar-user-name"/>
                <Label fx:id="lblRol" styleClass="sidebar-user-role"/>
                <Button text="Cerrar sesión" styleClass="sidebar-logout" onAction="#onCerrarSesion"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contenido" styleClass="content-area"/>
    </center>
</BorderPane>
