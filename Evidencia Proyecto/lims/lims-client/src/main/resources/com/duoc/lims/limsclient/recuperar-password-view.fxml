<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.duoc.lims.limsclient.controller.RecuperarPasswordController"
           styleClass="root-background">
    <VBox styleClass="card" maxWidth="360" maxHeight="-Infinity" alignment="CENTER" spacing="14">
        <padding>
            <Insets top="36" right="36" bottom="28" left="36"/>
        </padding>

        <Label text="Recuperar contraseña" styleClass="title-label" wrapText="true"
               alignment="CENTER" textAlignment="CENTER"/>
        <Label text="Ingresa tu usuario y enviaremos tu solicitud a un administrador"
               styleClass="subtitle-label" wrapText="true" alignment="CENTER" textAlignment="CENTER"/>

        <VBox spacing="4" alignment="CENTER_LEFT">
            <Label text="Usuario" styleClass="field-label"/>
            <TextField fx:id="usernameField" promptText="usuario" styleClass="text-field"/>
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>
        <Label fx:id="successLabel" styleClass="success-label" wrapText="true" managed="false" visible="false"/>

        <Button text="Enviar solicitud" styleClass="primary-button" maxWidth="Infinity" onAction="#onEnviarSolicitud"/>
        <Hyperlink text="Volver al inicio de sesión" styleClass="link-label" onAction="#onVolver"/>
    </VBox>
</StackPane>