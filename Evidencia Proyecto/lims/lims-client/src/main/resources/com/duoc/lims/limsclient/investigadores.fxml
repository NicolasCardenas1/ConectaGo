<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Investigadores que encargan muestreos y reciben los informes -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.duoc.lims.limsclient.controller.InvestigadoresController"
      styleClass="page">

    <VBox spacing="3">
        <Label text="Investigadores" styleClass="page-title"/>
        <Label text="Quienes encargan los muestreos y reciben el informe de resultados" styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="+ Nuevo investigador" styleClass="btn-primary" onAction="#onNuevo"/>
        <Button fx:id="btnEditar" text="Editar" styleClass="btn-secondary" onAction="#onEditar"/>
        <Button fx:id="btnEstado" text="Desactivar" styleClass="btn-secondary" onAction="#onCambiarEstado"/>
        <TextField fx:id="txtBuscar" promptText="Buscar por nombre, institución o proyecto..." styleClass="search-field"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblMensaje" wrapText="true"/>
    </HBox>

    <TableView fx:id="tabla" styleClass="lims-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colNombre" text="NOMBRE" prefWidth="170"/>
            <TableColumn fx:id="colInstitucion" text="INSTITUCIÓN" prefWidth="170"/>
            <TableColumn fx:id="colProyecto" text="PROYECTO / LÍNEA" prefWidth="200"/>
            <TableColumn fx:id="colEmail" text="EMAIL" prefWidth="170"/>
            <TableColumn fx:id="colTelefono" text="TELÉFONO" prefWidth="110"/>
            <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="90"/>
        </columns>
        <placeholder>
            <Label text="Aún no hay investigadores. Registra el primero con + Nuevo investigador."/>
        </placeholder>
    </TableView>
</VBox>
