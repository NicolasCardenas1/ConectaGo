<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.duoc.lims.limsclient.controller.RegistroMuestraController"
      spacing="16" style="-fx-padding: 20;">

    <Label text="Registrar Nueva Muestra" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
    <Label text="Completa los datos para generar el código único de la muestra" style="-fx-text-fill: #666;" />

    <GridPane hgap="20" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="250" />
            <ColumnConstraints minWidth="250" />
        </columnConstraints>

        <Label text="Código de muestra" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
        <Label text="Tipo de muestra" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-weight: bold;" />

        <TextField fx:id="txtCodigo" text="(autogenerado al guardar)" editable="false" disable="true"
                   GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <ComboBox fx:id="cbTipoMuestra" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250" />

        <Label text="Cliente" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
        <Label text="Prioridad" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-weight: bold;" />

        <TextField fx:id="txtCliente" promptText="Ej: Clínica Puerto Montt" GridPane.rowIndex="3" GridPane.columnIndex="0" />
        <ComboBox fx:id="cbPrioridad" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="250" />

        <Label text="Observaciones" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
        <TextArea fx:id="txtObservaciones" promptText="Detalles adicionales de la muestra..."
                  prefRowCount="4" GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2" />
    </GridPane>

    <Label fx:id="lblEstado" style="-fx-text-fill: #b00;" />

    <HBox spacing="10">
        <Button fx:id="btnGuardar" text="Guardar muestra" onAction="#onGuardar"
                style="-fx-background-color: #2f5d8a; -fx-text-fill: white;" />
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#onCancelar" />
    </HBox>

</VBox>