<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.duoc.lims.limsclient.controller.RegistroMuestraController"
      styleClass="page">

    <VBox spacing="3">
        <Label text="Registrar Nueva Muestra" styleClass="page-title"/>
        <Label text="Completa los datos para generar el código único de la muestra" styleClass="page-subtitle"/>
    </VBox>

    <VBox styleClass="card-panel" spacing="16" maxWidth="760">
        <GridPane hgap="24" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="300" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="300" hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Código de muestra" styleClass="field-name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label text="Tipo de muestra *" styleClass="field-name" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <TextField fx:id="txtCodigo" text="(autogenerado al guardar)" editable="false" disable="true"
                       styleClass="form-field" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbTipoMuestra" maxWidth="Infinity" styleClass="form-field"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Cliente *" styleClass="field-name" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label text="Prioridad *" styleClass="field-name" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <TextField fx:id="txtCliente" promptText="Ej: Clínica Puerto Montt" styleClass="form-field"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbPrioridad" maxWidth="Infinity" styleClass="form-field"
                      GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Observaciones" styleClass="field-name" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextArea fx:id="txtObservaciones" promptText="Detalles adicionales de la muestra..."
                      prefRowCount="4" wrapText="true"
                      GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
        </GridPane>

        <Label fx:id="lblEstado" styleClass="status-text" wrapText="true"/>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="btnCancelar" text="Cancelar" styleClass="btn-secondary" onAction="#onCancelar"/>
            <Button fx:id="btnGuardar" text="Guardar muestra" styleClass="btn-primary" onAction="#onGuardar"/>
        </HBox>
    </VBox>
</VBox>
