<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Historial de informes emitidos (RF05) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.duoc.lims.limsclient.controller.ReportesController"
      styleClass="page">

    <VBox spacing="3">
        <Label text="Informes emitidos" styleClass="page-title"/>
        <Label text="Historial de informes PDF generados. Selecciona uno para abrirlo o guardarlo." styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnDescargar" text="Abrir / descargar PDF" styleClass="btn-primary" onAction="#onDescargar"/>
        <Button text="Actualizar" styleClass="btn-secondary" onAction="#onActualizar"/>
        <TextField fx:id="txtBuscar" promptText="Buscar por N° de informe, muestra o investigador..." styleClass="search-field"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblMensaje" wrapText="true"/>
    </HBox>

    <TableView fx:id="tabla" styleClass="lims-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colNumero" text="N° INFORME" prefWidth="140"/>
            <TableColumn fx:id="colMuestra" text="MUESTRA" prefWidth="110"/>
            <TableColumn fx:id="colTipo" text="TIPO" prefWidth="100"/>
            <TableColumn fx:id="colInvestigador" text="INVESTIGADOR" prefWidth="160"/>
            <TableColumn fx:id="colVersion" text="VERSIÓN" prefWidth="80"/>
            <TableColumn fx:id="colEmitidoPor" text="EMITIDO POR" prefWidth="150"/>
            <TableColumn fx:id="colFecha" text="FECHA DE EMISIÓN" prefWidth="150"/>
        </columns>
        <placeholder>
            <Label text="Aún no se ha emitido ningún informe. Genéralo desde el detalle de una muestra aprobada."/>
        </placeholder>
    </TableView>
</VBox>
